{
  "name": "mcp-twake-mail",
  "version": "3.0.0",
  "description": "MCP server for Twake.ai Mail: give any MCP-compatible AI assistant secure access to your sovereign JMAP mailbox (Twake Mail, Apache James\u2026)",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "mcp-twake-mail": "./build/index.js"
  },
  "files": [
    "build",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "jmap",
    "email",
    "twake",
    "twake.ai",
    "linagora",
    "ai",
    "assistant",
    "sovereign",
    "open-source"
  ],
  "author": "LINAGORA <https://linagora.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/mcp-twake-mail.git"
  },
  "homepage": "https://github.com/linagora/mcp-twake-mail#readme",
  "bugs": {
    "url": "https://github.com/linagora/mcp-twake-mail/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "commander": "^15.0.0",
    "marked": "^17.0.1",
    "oauth-callback": "^3.1.1",
    "open": "^11.0.4",
    "openid-client": "^6.8.8",
    "pino": "^10.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "vitest-fetch-mock": "^0.4.0"
  }
}
